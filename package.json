{
  "name": "termul",
  "version": "1.0.0",
  "description": "Terminal emulator",
  "main": "dist/index.js",
  "author": "admodevops",
  "license": "MIT",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run typecheck:renderer && npm run build:renderer",
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "typescript": "^7.0.2",
    "vite": "^6.3.5",
    "wait-on": "^8.0.4"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.30.1"
  }
}
